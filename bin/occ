#!/usr/bin/env python3
import os
import platform
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root / "scripts"))
from common import load, require, verify_files  # noqa: E402

os_name = {"Darwin": "darwin", "Linux": "linux"}.get(platform.system())
arch = {"arm64": "arm64", "aarch64": "arm64", "x86_64": "amd64"}.get(platform.machine())
if not os_name or not arch:
    sys.exit("occ: supported operator platforms are macOS/Linux AMD64/ARM64")
binary = root / "cli" / f"occ-{os_name}-{arch}"
try:
    manifest = load(root / "manifest.json")
    name = str(binary.relative_to(root))
    require(name in manifest, "CLI missing from delivered inventory")
    verify_files(root, {name: manifest[name]})
except (ValueError, KeyError, OSError) as error:
    sys.exit(f"occ: {error}")
os.execv(binary, [str(binary), *sys.argv[1:]])
