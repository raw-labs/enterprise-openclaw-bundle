#!/usr/bin/env python3
"""Run the package's OCE input preparation tool."""

import runpy
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
sys.dont_write_bytecode = True
sys.path.insert(0, str(root / "lib"))
runpy.run_path(str(root / "lib/prepare.py"), run_name="__main__")
