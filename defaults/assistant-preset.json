{
  "name": "Assistant",
  "template": {
    "variables": {
      "name": {
        "type": "string",
        "description": "Name for the new Agent"
      },
      "model": {
        "type": "string",
        "description": "OpenAI model ID without the openai/ prefix",
        "default": "gpt-6.1-sol"
      },
      "modelSecret": {
        "type": "password",
        "description": "Model API key; stored as a Secret when you create the Agent"
      }
    },
    "agent": {
      "name": "{{ vars.name }}",
      "executionMode": "embedded",
      "backendId": null,
      "harnessAuth": {
        "method": "api_key",
        "secret": "{{ vars.modelSecret }}"
      },
      "plugins": {},
      "initialWorkspaceFiles": {
        "AGENTS.md": "You are {{ vars.name }}\u2019s assistant. Work in your workspace. Follow the user\u2019s instructions and repository AGENTS.md files. Do not reveal credentials. Ask before sending messages, publishing changes or deleting user data.\n",
        "IDENTITY.md": "# Identity\nName: {{ vars.name }}\n"
      }
    },
    "configuration": {
      "values": {
        "gateway": {
          "mode": "local",
          "bind": "lan",
          "controlUi": {
            "enabled": true,
            "allowedOrigins": [
              "http://127.0.0.1:18789",
              "http://localhost:18789"
            ]
          },
          "auth": {
            "password": {
              "source": "env",
              "provider": "default",
              "id": "OPENCLAW_GATEWAY_PASSWORD"
            }
          },
          "http": {
            "endpoints": {
              "chatCompletions": {
                "enabled": true
              }
            }
          }
        },
        "agents": {
          "defaults": {
            "model": "openai/{{ vars.model }}",
            "models": {
              "openai/{{ vars.model }}": {
                "agentRuntime": {
                  "id": "openclaw"
                }
              }
            },
            "skipBootstrap": true,
            "thinkingDefault": "medium"
          }
        },
        "models": {
          "providers": {
            "openai": {
              "baseUrl": "https://api.openai.com/v1",
              "api": "openai-responses",
              "models": [
                {
                  "id": "{{ vars.model }}",
                  "name": "{{ vars.model }}",
                  "reasoning": true,
                  "thinkingLevelMap": {
                    "off": null,
                    "minimal": "low",
                    "xhigh": "xhigh",
                    "max": "max"
                  },
                  "compat": {
                    "supportsReasoningEffort": true,
                    "supportedReasoningEfforts": [
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ],
                    "supportsTemperature": false
                  }
                }
              ]
            }
          }
        },
        "browser": {
          "enabled": false
        },
        "tools": {
          "elevated": {
            "enabled": false
          },
          "web": {
            "search": {
              "enabled": true
            },
            "fetch": {
              "enabled": true
            }
          }
        }
      },
      "secretBindings": {}
    }
  }
}
