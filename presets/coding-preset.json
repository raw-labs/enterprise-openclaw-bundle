{
  "name": "Coding",
  "template": {
    "variables": {
      "name": {
        "type": "string",
        "description": "Name for the new Agent"
      },
      "model": {
        "type": "string",
        "description": "Codex model ID without the codex/ prefix",
        "default": "gpt-6.1-sol"
      },
      "modelSecret": {
        "type": "password",
        "description": "Model API key; stored as a Secret when you create the Agent"
      }
    },
    "agent": {
      "name": "{{ vars.name }}",
      "executionMode": "dedicated",
      "backendId": null,
      "harnessAuth": {
        "method": "api_key",
        "secret": "{{ vars.modelSecret }}"
      },
      "plugins": {},
      "initialWorkspaceFiles": {
        "AGENTS.md": "You are {{ vars.name }}\u2019s assistant. Work in your workspace. Follow the user\u2019s instructions and repository AGENTS.md files. Do not reveal credentials. Ask before sending messages, publishing changes or deleting user data.\n",
        "IDENTITY.md": "# Identity\nName: {{ vars.name }}\n"
      }
    },
    "configuration": {
      "values": {
        "gateway": {
          "mode": "local",
          "bind": "lan",
          "controlUi": {
            "enabled": true,
            "allowedOrigins": [
              "http://127.0.0.1:18789",
              "http://localhost:18789"
            ],
            "experimental": {
              "customPlugins": false
            },
            "communityInvite": false
          },
          "auth": {
            "password": {
              "source": "env",
              "provider": "default",
              "id": "OPENCLAW_GATEWAY_PASSWORD"
            }
          },
          "http": {
            "endpoints": {
              "chatCompletions": {
                "enabled": true
              }
            }
          }
        },
        "agents": {
          "defaults": {
            "model": "codex/{{ vars.model }}",
            "models": {
              "codex/{{ vars.model }}": {
                "agentRuntime": {
                  "id": "codex"
                }
              }
            },
            "skipBootstrap": true,
            "thinkingDefault": "medium"
          }
        },
        "models": {
          "providers": {
            "codex": {
              "baseUrl": "http://127.0.0.1:9",
              "api": "openai-responses",
              "models": [
                {
                  "id": "{{ vars.model }}",
                  "name": "{{ vars.model }}",
                  "reasoning": true,
                  "thinkingLevelMap": {
                    "off": null,
                    "minimal": "low",
                    "xhigh": "xhigh",
                    "max": "max"
                  },
                  "compat": {
                    "supportsReasoningEffort": true,
                    "supportedReasoningEfforts": [
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ],
                    "supportsTemperature": false
                  }
                }
              ]
            }
          }
        },
        "browser": {
          "enabled": false
        },
        "tools": {
          "elevated": {
            "enabled": false
          },
          "web": {
            "search": {
              "enabled": true,
              "openaiCodex": {
                "enabled": true,
                "mode": "cached"
              }
            },
            "fetch": {
              "enabled": false
            }
          },
          "alsoAllow": [
            "connections_search",
            "connections_describe",
            "connections_call"
          ]
        },
        "plugins": {
          "entries": {
            "codex": {
              "enabled": true,
              "config": {
                "appServer": {
                  "mode": "guardian",
                  "transport": "websocket",
                  "url": "${APP_SERVER_URL}",
                  "authToken": "${APP_SERVER_TOKEN}",
                  "approvalPolicy": "on-request",
                  "sandbox": "workspace-write",
                  "networkProxy": {
                    "enabled": true,
                    "baseProfile": "workspace",
                    "mode": "limited",
                    "domains": {
                      "codeload.github.com": "allow",
                      "dl.google.com": "allow",
                      "github.com": "allow",
                      "go.dev": "allow",
                      "nodejs.org": "allow",
                      "proxy.golang.org": "allow",
                      "registry.npmjs.org": "allow",
                      "storage.googleapis.com": "allow",
                      "sum.golang.org": "allow"
                    },
                    "unixSockets": {},
                    "enableSocks5": false,
                    "enableSocks5Udp": false,
                    "allowUpstreamProxy": false,
                    "allowLocalBinding": false,
                    "dangerouslyAllowNonLoopbackProxy": false,
                    "dangerouslyAllowAllUnixSockets": false
                  },
                  "approvalsReviewer": "user"
                }
              }
            },
            "openclaw-connections": {
              "enabled": true,
              "config": {}
            }
          }
        },
        "skills": {
          "entries": {
            "notion": {
              "enabled": false
            }
          }
        }
      },
      "secretBindings": {}
    }
  }
}
